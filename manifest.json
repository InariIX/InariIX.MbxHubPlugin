{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.inariix.mbxhub-plugin",
  "name": "MBXHub (MusicBee)",
  "version": "0.1.5",
  "description": "Control MusicBee through MBXHub with playback actions, playlist selection, live status, and a music player widget.",
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": false,
    "services": []
  },
  "icon": "Assets/icon.png",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/InariIX.MbxHubPlugin.dll",
      "runtime": { "kind": "FrameworkDependent", "dotnetVersion": "10.0" }
    }
  },
  "publisher": {
    "name": "InariIX",
    "id": "io.github.inariix",
    "url": "https://github.com/InariIX"
  },
  "license": "MIT",
  "repository": "https://github.com/InariIX/InariIX.MbxHubPlugin",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  },
  "permissions": [
    "host:variables",
    "events:publish"
  ]
}
